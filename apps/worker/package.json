{
  "name": "@shopee-auto-affiliate-ai/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --tsconfig ../../tsconfig.runtime.json src/index.ts",
    "evolution:test-message": "tsx --tsconfig ../../tsconfig.runtime.json src/evolution-single-message-test.ts",
    "whatsapp:e2e-test": "tsx --tsconfig ../../tsconfig.runtime.json src/whatsapp-dispatch-e2e.ts",
    "whatsapp:group-test": "tsx --tsconfig ../../tsconfig.runtime.json src/whatsapp-group-test.ts",
    "whatsapp:routing-certification": "tsx --tsconfig ../../tsconfig.runtime.json src/whatsapp-routing-certification.ts",
    "commercial:confirm": "tsx --tsconfig ../../tsconfig.runtime.json src/commercial-pipeline-confirm.ts",
    "commercial:automation:preview": "tsx --tsconfig ../../tsconfig.runtime.json src/commercial-automation-preview.ts",
    "commercial:automation:worker": "tsx --tsconfig ../../tsconfig.runtime.json src/commercial-automation-worker.ts",
    "commercial:outbox:status": "tsx --tsconfig ../../tsconfig.runtime.json src/commercial-outbox-cli.ts status",
    "commercial:outbox:reconcile": "tsx --tsconfig ../../tsconfig.runtime.json src/commercial-outbox-cli.ts reconcile",
    "commercial:execution:status": "tsx --tsconfig ../../tsconfig.runtime.json src/commercial-execution-cli.ts status",
    "commercial:execution:recover": "tsx --tsconfig ../../tsconfig.runtime.json src/commercial-execution-cli.ts recover",
    "whatsapp:dispatch:worker": "tsx --tsconfig ../../tsconfig.runtime.json src/whatsapp-dispatch-runtime.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "commercial:image:e2e": "tsx --tsconfig ../../tsconfig.runtime.json src/commercial-image-dispatch-e2e.ts"
  },
  "dependencies": {
    "@shopee-auto-affiliate-ai/config": "workspace:*",
    "@shopee-auto-affiliate-ai/queue": "workspace:*",
    "@shopee-auto-affiliate-ai/shared": "workspace:*",
    "bullmq": "^5.0.0",
    "@shopee-auto-affiliate-ai/database": "workspace:*",
    "@shopee-auto-affiliate-ai/providers": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.16.0"
  }
}

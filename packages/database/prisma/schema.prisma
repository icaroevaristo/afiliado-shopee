generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProductLead {
  copies                 GeneratedCopy[]
  whatsappDispatches     WhatsAppDispatch[]
  coupons                Coupon[]
  commercialPipelineRuns CommercialPipelineRun[]
  manualPublicationRequests ManualPublicationRequest[] @relation("ManualPublicationRequestProduct")
  commercialOfferSnapshots CommercialOfferSnapshot[]
  commercialPromotionCandidates CommercialPromotionCandidate[]
  id                     String                  @id @default(cuid())
  source                 ShopeeOfferSource       @default(MOCK)
  providerProductId      String
  nome                   String
  categoria              String
  preco                  Decimal                 @db.Decimal(14, 4)
  precoMin               Decimal?                @db.Decimal(14, 4)
  precoMax               Decimal?                @db.Decimal(14, 4)
  desconto               Float
  nota                   Float
  vendidos               Int
  comissao               Float
  commissionAmount       Decimal?                @db.Decimal(14, 4)
  sellerCommissionRate   Float?
  shopeeCommissionRate   Float?
  loja                   String
  shopId                 String?
  shopType               Int[]                   @default([])
  categoryIds            String[]                @default([])
  urlImagem              String
  productLink            String?                 @map("url")
  affiliateLink          String?
  offerStartsAt          DateTime?
  offerEndsAt            DateTime?
  fetchedAt              DateTime                @default(now())
  lastSeenAt             DateTime                @default(now())
  unavailableAt          DateTime?
  commercialSnapshotRevision Int                 @default(0)
  commercialSnapshotFingerprint String?
  title                  String
  score                  Int?
  scoreUpdatedAt         DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([source, providerProductId])
  @@index([source, lastSeenAt])
  @@index([offerEndsAt, unavailableAt])
}

model ShopeeCategory {
  id            String   @id
  name          String?
  parentId      String?
  mappingSource String   @default("OFFICIAL_PRODUCT_CATEGORY_ID")
  discoveredAt  DateTime
  updatedAt     DateTime @updatedAt

  @@index([name])
  @@index([parentId])
}

model CommercialOfferSnapshot {
  id             String      @id @default(cuid())
  productId      String
  product        ProductLead @relation(fields: [productId], references: [id], onDelete: Restrict)
  revision       Int
  fingerprint    String
  price          Decimal     @db.Decimal(14, 4)
  priceMin       Decimal?    @db.Decimal(14, 4)
  priceMax       Decimal?    @db.Decimal(14, 4)
  discountRate   Float
  commissionRate Float
  observedRating Float
  observedSales  Int
  offerStartsAt  DateTime?
  offerEndsAt    DateTime?
  unavailableAt  DateTime?
  capturedAt     DateTime
  createdAt      DateTime    @default(now())
  promotionCandidates CommercialPromotionCandidate[]
  generatedCopies GeneratedCopy[]
  copyGenerationAttempts CommercialCopyGenerationAttempt[]
  manualPublicationRequests ManualPublicationRequest[] @relation("ManualPublicationRequestSnapshot")
  commercialPreparedMessages CommercialPreparedMessage[]

  @@unique([productId, revision])
  @@index([productId, revision])
  @@index([productId, capturedAt])
  @@index([fingerprint])
}

model GeneratedCopy {
  id                 String             @id @default(cuid())
  productId          String
  product            ProductLead        @relation(fields: [productId], references: [id], onDelete: Cascade)
  whatsappDispatches WhatsAppDispatch[]
  source             GeneratedCopySource @default(LEGACY_TEMPLATE)
  provider           String?
  model              String?
  promptVersion      String?
  validationVersion  String?
  inputFingerprint   String?             @unique
  snapshotId         String?
  snapshot           CommercialOfferSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  createdFromCandidateId String?
  usageInputTokens   Int?
  usageOutputTokens  Int?
  usageTotalTokens   Int?
  promotionCandidates CommercialPromotionCandidate[]
  generationAttempts CommercialCopyGenerationAttempt[]
  commercialPreparedMessages CommercialPreparedMessage[]
  titulo             String
  mensagem           String
  cta                String
  hashtags           String
  createdAt          DateTime           @default(now())

  @@index([productId])
  @@index([snapshotId])
}

model WhatsAppDestination {
  id                     String                  @id @default(cuid())
  name                   String
  destination            String
  type                   WhatsAppDestinationType @default(INDIVIDUAL)
  active                 Boolean                 @default(true)
  paused                 Boolean                 @default(false)
  available              Boolean                 @default(true)
  fingerprint            String?
  sourceInstanceName     String?
  assignedInstanceName   String?
  assignedInstance       WhatsAppInstance?       @relation(fields: [assignedInstanceName], references: [name], onDelete: Restrict)
  assignmentRevision     Int                     @default(1)
  instanceAssignments    WhatsAppGroupInstanceAssignment[]
  memberCount            Int?
  ownerIsParticipant     Boolean?
  discoveredAt           DateTime?
  lastSyncedAt           DateTime?
  dispatches             WhatsAppDispatch[]
  commercialPipelineRuns CommercialPipelineRun[]
  anchoredCampaigns      CommercialGroupCampaign[]
  manualPublicationTargets ManualPublicationTarget[] @relation("ManualPublicationTargetDestination")
  commercialPreparedMessages CommercialPreparedMessage[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([destination, sourceInstanceName])
  @@index([assignedInstanceName])
  @@index([type, active, available])
}

model WhatsAppInstance {
  name                      String                       @id
  active                    Boolean                      @default(true)
  paused                    Boolean                      @default(false)
  destinations              WhatsAppDestination[]
  commercialPipelineRuns    CommercialPipelineRun[]
  whatsappDispatches        WhatsAppDispatch[]
  commercialDispatchOutboxes CommercialDispatchOutbox[]
  manualPublicationTargets ManualPublicationTarget[] @relation("ManualPublicationTargetInstance")
  commercialPreparedMessages CommercialPreparedMessage[]
  groupInstanceAssignments WhatsAppGroupInstanceAssignment[]
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
}

model WhatsAppGroupInstanceAssignment {
  id            String             @id @default(cuid())
  destinationId String
  destination   WhatsAppDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  instanceName  String
  instance      WhatsAppInstance   @relation(fields: [instanceName], references: [name], onDelete: Restrict)
  position      Int
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt

  @@unique([destinationId, position])
  @@unique([destinationId, instanceName])
  @@index([instanceName])
}

model CommercialNiche {
  id                String                    @id @default(cuid())
  name              String
  slug              String                    @unique
  active            Boolean                   @default(true)
  categoryIds       String[]                  @default([])
  includeKeywords   String[]                  @default([])
  excludeKeywords   String[]                  @default([])
  minPrice          Decimal?                  @db.Decimal(14, 4)
  maxPrice          Decimal?                  @db.Decimal(14, 4)
  minDiscountRate   Float                     @default(5)
  minRating         Float                     @default(0)
  minSales          Int                       @default(0)
  minCommissionRate Float                     @default(0)
  minimumScore      Int                       @default(60)
  campaigns         CommercialGroupCampaign[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([active])
}

model CommercialGroupCampaign {
  id                      String               @id @default(cuid())
  name                    String
  logicalGroupFingerprint String               @unique
  anchorDestinationId     String?
  anchorDestination       WhatsAppDestination? @relation(fields: [anchorDestinationId], references: [id], onDelete: SetNull)
  nicheId                 String
  niche                   CommercialNiche      @relation(fields: [nicheId], references: [id], onDelete: Restrict)
  active                  Boolean              @default(false)
  cadenceMinutes          Int                  @default(15)
  timezone                String               @default("America/Sao_Paulo")
  allowedStartTime        String               @default("07:00")
  allowedEndTime          String               @default("22:00")
  dailyLimit              Int                  @default(60)
  failureCount            Int                  @default(0)
  nextEligibleAt          DateTime?
  attemptExecutionId      String?
  attemptReservedAt       DateTime?
  attemptLeaseExpiresAt   DateTime?
  queueTargetSize         Int                  @default(40)
  dedupeDays              Int                  @default(30)
  promotionCandidates     CommercialPromotionCandidate[]
  manualPublicationTargets ManualPublicationTarget[] @relation("ManualPublicationTargetCampaign")
  commercialPreparedMessages CommercialPreparedMessage[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([active])
  @@index([nicheId])
}

model CommercialPromotionCandidate {
  id               String                             @id @default(cuid())
  campaignId       String
  campaign         CommercialGroupCampaign            @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  productId        String
  product          ProductLead                        @relation(fields: [productId], references: [id], onDelete: Restrict)
  snapshotId       String
  snapshot         CommercialOfferSnapshot            @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  generatedCopyId  String?
  generatedCopy    GeneratedCopy?                      @relation(fields: [generatedCopyId], references: [id], onDelete: SetNull)
  copyGenerationAttempts CommercialCopyGenerationAttempt[]
  status           CommercialPromotionCandidateStatus @default(QUEUED)
  rankPosition     Int?
  commercialScore  Int
  scorePolicyVersion String
  minimumScoreUsed Int
  scoreBreakdown   Json
  promotionSignals CommercialPromotionSignal[]
  priceDropPercent Decimal?                           @db.Decimal(7, 4)
  queuedAt         DateTime
  lastEvaluatedAt  DateTime
  expiresAt        DateTime?
  dedupeUntil      DateTime?
  blockedReason    String?
  manualSelectionOverride Boolean                         @default(false)
  createdAt        DateTime                           @default(now())
  updatedAt        DateTime                           @updatedAt
  manualPublicationTargets ManualPublicationTarget[] @relation("ManualPublicationTargetCandidate")
  commercialPreparedMessages CommercialPreparedMessage[]

  @@unique([campaignId, productId])
  @@index([campaignId, status, rankPosition])
  @@index([campaignId, updatedAt])
  @@index([snapshotId])
  @@index([generatedCopyId])
  @@index([expiresAt])
  @@index([dedupeUntil])
}

model CommercialCopyGenerationAttempt {
  id                    String                                @id @default(cuid())
  candidateId           String
  candidate             CommercialPromotionCandidate          @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  snapshotId            String
  snapshot              CommercialOfferSnapshot               @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  inputFingerprint      String                                @unique
  provider              String
  model                 String
  promptVersion         String
  validationVersion     String
  status                CommercialCopyGenerationAttemptStatus
  generatedCopyId       String?
  generatedCopy         GeneratedCopy?                        @relation(fields: [generatedCopyId], references: [id], onDelete: SetNull)
  failureCode           String?
  validationFailureCodes String[]                             @default([])
  requestMayHaveStarted Boolean                               @default(false)
  providerHttpStatus    Int?
  providerErrorCode     String?                               @db.VarChar(100)
  providerErrorType     String?                               @db.VarChar(100)
  providerErrorParam    String?                               @db.VarChar(100)
  inputTokens           Int?
  outputTokens          Int?
  totalTokens           Int?
  startedAt             DateTime
  completedAt           DateTime?
  createdAt             DateTime                              @default(now())
  updatedAt             DateTime                              @updatedAt

  @@index([candidateId, createdAt])
  @@index([snapshotId])
  @@index([status, createdAt])
  @@index([generatedCopyId])
}

model CommercialDiscoveryCheckpoint {
  id                    String                              @id @default(cuid())
  identityFingerprint   String                              @unique
  source                ShopeeOfferSource
  campaignId            String
  nicheId               String
  query                 Json
  page                  Int                                 @default(1)
  cursor                String?
  status                CommercialDiscoveryCheckpointStatus @default(ACTIVE)
  nextRefreshAt         DateTime?
  leaseOwnerId         String?
  leaseExpiresAt        DateTime?
  leaseRevision        Int                                 @default(0)
  lastRequestAt         DateTime?
  lastSuccessAt         DateTime?
  lastErrorCode         String?
  fetchedPages          Int                                 @default(0)
  fetchedProducts       Int                                 @default(0)
  createdAt             DateTime                            @default(now())
  updatedAt             DateTime                            @updatedAt

  @@index([status, nextRefreshAt])
  @@index([campaignId, nicheId, status])
  @@index([leaseExpiresAt])
}

model CommercialPreparedMessage {
  id                        String                          @id @default(cuid())
  campaignId                String
  campaign                  CommercialGroupCampaign         @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  groupDestinationId        String
  groupDestination          WhatsAppDestination             @relation(fields: [groupDestinationId], references: [id], onDelete: Restrict)
  instanceName              String
  instance                  WhatsAppInstance                @relation(fields: [instanceName], references: [name], onDelete: Restrict)
  logicalGroupFingerprint   String
  candidateId               String
  candidate                 CommercialPromotionCandidate    @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  snapshotId                String
  snapshot                  CommercialOfferSnapshot         @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  generatedCopyId           String
  generatedCopy             GeneratedCopy                   @relation(fields: [generatedCopyId], references: [id], onDelete: Restrict)
  copyPreview               String                          @default("")
  runId                     String?                         @unique
  run                       CommercialPipelineRun?          @relation(fields: [runId], references: [id], onDelete: Restrict)
  status                    CommercialPreparedMessageStatus @default(READY)
  reservationOwnerId        String?
  reservationLeaseExpiresAt DateTime?
  scheduleRevision          Int                             @default(1)
  assignmentRevision        Int                             @default(1)
  preparationRevision      Int                             @default(1)
  expiresAt                 DateTime
  offerEndsAt               DateTime?
  invalidatedReason         String?
  invalidatedAt             DateTime?
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt

  @@unique([campaignId, candidateId, snapshotId, groupDestinationId, instanceName, scheduleRevision, assignmentRevision, preparationRevision], map: "CommercialPreparedMessage_campaignId_candidateId_snapshotId_gro")
  @@index([campaignId, status, groupDestinationId, instanceName], map: "CommercialPreparedMessage_campaignId_status_groupDestinationId_")
  @@index([status, expiresAt])
  @@index([status, reservationLeaseExpiresAt])
  @@index([candidateId, snapshotId])
}

model WhatsAppDispatch {
  id                    String                    @id @default(cuid())
  productId             String
  product               ProductLead               @relation(fields: [productId], references: [id], onDelete: Cascade)
  generatedCopyId       String
  generatedCopy         GeneratedCopy             @relation(fields: [generatedCopyId], references: [id], onDelete: Cascade)
  destinationId         String
  destination           WhatsAppDestination       @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  instanceName          String?
  instance               WhatsAppInstance?        @relation(fields: [instanceName], references: [name], onDelete: Restrict)
  externalMessageId     String?
  status                WhatsAppDispatchStatus    @default(PENDING)
  attemptCount          Int                       @default(0)
  errorMessage          String?
  submittedAt           DateTime?
  confirmationDeadlineAt DateTime?
  sentAt                DateTime?
  deliveredAt           DateTime?
  readAt                DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  commercialPipelineRun CommercialPipelineRun?
  commercialOutbox      CommercialDispatchOutbox?
  manualRecovery        WhatsAppDispatchManualRecovery?
  manualPublicationTargets ManualPublicationTarget[] @relation("ManualPublicationTargetDispatch")

  @@unique([generatedCopyId, destinationId])
  @@index([productId])
  @@index([destinationId])
  @@index([status])
  @@index([status, sentAt])
  @@index([destinationId, status, sentAt])
  @@index([instanceName])
  @@index([status, confirmationDeadlineAt])
  @@index([instanceName, externalMessageId])
}

model WhatsAppDeliveryEventInbox {
  id                String                           @id @default(cuid())
  fingerprint       String                           @unique
  instanceName      String
  externalMessageId String
  status            WhatsAppDeliveryEventStatus
  occurredAt        DateTime
  receivedAt        DateTime                         @default(now())
  state             WhatsAppDeliveryEventInboxState @default(PENDING)
  appliedAt         DateTime?
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @default(now()) @updatedAt

  @@index([instanceName, externalMessageId, state, occurredAt], map: "WhatsAppDeliveryEventInbox_instanceName_externalMessageId_state")
  @@index([state, occurredAt])
}

model WhatsAppDispatchManualRecovery {
  id                   String                                  @id @default(cuid())
  dispatchId           String                                  @unique
  dispatch             WhatsAppDispatch                        @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  runId                String
  executionId          String
  candidateId          String
  campaignId           String
  jobId                String
  decision             WhatsAppDispatchManualRecoveryDecision
  confirmation         String
  attemptCountObserved Int
  authorizedAt         DateTime
  rearmedAt            DateTime?
  requeuedAt           DateTime?
  createdAt            DateTime                                @default(now())
  updatedAt            DateTime                                @updatedAt

  @@index([runId])
  @@index([executionId])
  @@index([candidateId])
  @@index([campaignId])
}

model Coupon {
  id              String             @id @default(cuid())
  source          CouponSource
  code            String
  description     String
  discountType    CouponDiscountType
  discountValue   Decimal            @db.Decimal(14, 4)
  minPurchase     Decimal?           @db.Decimal(14, 4)
  maxDiscount     Decimal?           @db.Decimal(14, 4)
  startsAt        DateTime?
  endsAt          DateTime?
  active          Boolean            @default(true)
  shopId          String?
  productId       String?
  product         ProductLead?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  terms           String?
  lastValidatedAt DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([active, startsAt, endsAt])
  @@index([shopId])
  @@index([productId])
}

model CommercialPipelineRun {
  id                    String                         @id @default(cuid())
  executionId           String?                        @unique
  instanceName          String?
  instance               WhatsAppInstance?             @relation(fields: [instanceName], references: [name], onDelete: Restrict)
  mode                  CommercialPipelineRunMode
  status                CommercialPipelineRunStatus
  productId             String?
  product               ProductLead?                   @relation(fields: [productId], references: [id], onDelete: SetNull)
  groupDestinationId    String?
  groupDestination      WhatsAppDestination?           @relation(fields: [groupDestinationId], references: [id], onDelete: SetNull)
  productName           String?
  productPrice          Decimal?                       @db.Decimal(14, 4)
  groupName             String?
  groupFingerprint      String?
  score                 Int?
  scorePolicyVersion     String?
  minimumScoreUsed       Int?
  maximumScoreObserved   Int?
  selectedScoreBreakdown Json?
  candidateCount        Int                            @default(0)
  eligibleCount         Int                            @default(0)
  rejectedCount         Int                            @default(0)
  rejectionSummary      Json
  selectionReasons      Json
  copyPreview           String?
  plannedSubIds         Json
  dispatchId            String?                        @unique
  dispatch              WhatsAppDispatch?              @relation(fields: [dispatchId], references: [id], onDelete: SetNull)
  jobId                 String?                        @unique
  confirmedAt           DateTime?
  finalStatus           CommercialPipelineFinalStatus?
  investigationRequired Boolean                        @default(false)
  failureCode           String?
  createdAt             DateTime                       @default(now())
  completedAt           DateTime?
  dispatchOutbox        CommercialDispatchOutbox?
  commercialPreparedMessage CommercialPreparedMessage?
  manualPublicationTargets ManualPublicationTarget[] @relation("ManualPublicationTargetRun")

  @@index([createdAt])
  @@index([status, mode])
  @@index([productId])
  @@index([groupDestinationId])
  @@index([finalStatus])
  @@index([investigationRequired])
  @@index([instanceName])
}

model CommercialDispatchOutbox {
  id              String                         @id @default(cuid())
  commercialRunId String                         @unique
  commercialRun   CommercialPipelineRun          @relation(fields: [commercialRunId], references: [id], onDelete: Restrict)
  dispatchId      String                         @unique
  dispatch        WhatsAppDispatch               @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  jobId           String                         @unique
  instanceName    String?
  instance       WhatsAppInstance?              @relation(fields: [instanceName], references: [name], onDelete: Restrict)
  status          CommercialDispatchOutboxStatus @default(PENDING)
  failureCode     String?
  createdAt       DateTime                       @default(now())
  publishedAt     DateTime?
  manualPublicationTargets ManualPublicationTarget[] @relation("ManualPublicationTargetOutbox")

  @@index([status, createdAt])
  @@index([instanceName])
}

model ManualPublicationRequest {
  id                         String                         @id @default(cuid())
  idempotencyKey             String                         @unique
  payloadHash                String
  mode                       ManualPublicationRequestMode  @default(SEND)
  productId                  String
  product                    ProductLead                    @relation("ManualPublicationRequestProduct", fields: [productId], references: [id], onDelete: Restrict)
  requestedSnapshotId        String
  requestedSnapshot          CommercialOfferSnapshot       @relation("ManualPublicationRequestSnapshot", fields: [requestedSnapshotId], references: [id], onDelete: Restrict)
  requestedSnapshotRevision  Int
  requestedSnapshotFingerprint String
  status                     ManualPublicationRequestStatus @default(ACCEPTED)
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  completedAt                DateTime?
  processingOwnerId          String?
  processingLeaseExpiresAt   DateTime?
  targets                    ManualPublicationTarget[]

  @@index([productId, status])
  @@index([status, createdAt])
  @@index([status, processingLeaseExpiresAt])
}

model ManualPublicationTarget {
  id                     String                         @id @default(cuid())
  requestId              String
  request                ManualPublicationRequest       @relation(fields: [requestId], references: [id], onDelete: Restrict)
  destinationId          String
  destination             WhatsAppDestination            @relation("ManualPublicationTargetDestination", fields: [destinationId], references: [id], onDelete: Restrict)
  campaignId             String
  campaign               CommercialGroupCampaign         @relation("ManualPublicationTargetCampaign", fields: [campaignId], references: [id], onDelete: Restrict)
  logicalGroupFingerprint String
  assignedInstanceName   String
  assignedInstance       WhatsAppInstance             @relation("ManualPublicationTargetInstance", fields: [assignedInstanceName], references: [name], onDelete: Restrict)
  candidateId            String?
  candidate              CommercialPromotionCandidate?  @relation("ManualPublicationTargetCandidate", fields: [candidateId], references: [id], onDelete: Restrict)
  runId                  String?
  run                    CommercialPipelineRun?         @relation("ManualPublicationTargetRun", fields: [runId], references: [id], onDelete: Restrict)
  dispatchId             String?
  dispatch               WhatsAppDispatch?              @relation("ManualPublicationTargetDispatch", fields: [dispatchId], references: [id], onDelete: Restrict)
  outboxId               String?
  outbox                 CommercialDispatchOutbox?       @relation("ManualPublicationTargetOutbox", fields: [outboxId], references: [id], onDelete: Restrict)
  status                 ManualPublicationTargetStatus  @default(ACCEPTED)
  blockedReason          String?
  investigationRequired  Boolean                        @default(false)
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  @@unique([requestId, destinationId])
  @@index([destinationId, status])
  @@index([campaignId, status])
  @@index([runId])
  @@index([dispatchId])
  @@index([outboxId])
}

model CommercialAutomationSettings {
  id                       String    @id @default("commercial-automation")
  paused                   Boolean   @default(true)
  pausedAt                 DateTime? @default(now())
  resumedAt                DateTime?
  allowedStartTime         String?
  allowedEndTime           String?
  timezone                 String?
  minimumIntervalMinutes   Int?
  staggerMinutes            Int?
  dailyGlobalLimit         Int?
  dailyGroupLimit          Int?
  dailyShopeeHttpLimit     Int?
  dailyOpenAiGenerationLimit Int?
  usableCandidateLowWatermark Int @default(2)
  usableCandidateTarget Int @default(4)
  preparedLowWatermark Int @default(1)
  preparedTarget Int @default(2)
  discoveryPagesPerRun Int @default(1)
  discoveryRefreshCooldownMinutes Int @default(60)
  scheduleRevision         Int       @default(0)
  updatedAt                DateTime  @default(now()) @updatedAt
}

model CommercialExternalProviderUsage {
  provider  String   @db.VarChar(16)
  dayKey    String   @db.VarChar(10)
  usedCount Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@id([provider, dayKey])
  @@index([dayKey])
}

model CommercialAutomationExecution {
  id              String                              @id @default(cuid())
  schedulerJobId  String
  bullMqJobId     String?                             @unique
  activeKey       String?                             @unique
  ownerId         String?
  heartbeatAt     DateTime?
  leaseExpiresAt  DateTime?
  mode            CommercialAutomationExecutionMode
  status          CommercialAutomationExecutionStatus
  externalStage   CommercialAutomationExecutionExternalStage @default(NOT_REACHED)
  reasons         Json
  commercialRunId String?
  failureCode     String?
  startedAt       DateTime                            @default(now())
  completedAt     DateTime?

  @@index([startedAt])
  @@index([status])
  @@index([status, leaseExpiresAt])
  @@index([commercialRunId])
}

enum WhatsAppDispatchStatus {
  PENDING
  PROCESSING
  SUBMITTED
  SENT
  DELIVERED
  READ
  FAILED
  AMBIGUOUS
}

enum WhatsAppDeliveryEventStatus {
  PENDING
  SERVER_ACK
  DELIVERY_ACK
  READ
  ERROR
}

enum WhatsAppDeliveryEventInboxState {
  PENDING
  APPLIED
  AMBIGUOUS
}

enum WhatsAppDispatchManualRecoveryDecision {
  CONFIRMED_NON_DELIVERY
  AMBIGUITY_ACCEPTED_NO_RETRY
}

enum WhatsAppDestinationType {
  INDIVIDUAL
  GROUP
}

enum ShopeeOfferSource {
  MOCK
  MANUAL
  OFFICIAL
}

enum CouponSource {
  MANUAL
  OFFICIAL
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CommercialPipelineRunMode {
  DRY_RUN
  CONFIRMED
}

enum CommercialPipelineRunStatus {
  STARTED
  COMPLETED
  BLOCKED
  FAILED
}

enum CommercialPipelineFinalStatus {
  PENDING
  SENT
  FAILED
  AMBIGUOUS
}

enum CommercialDispatchOutboxStatus {
  PENDING
  PUBLISHED
  AMBIGUOUS
}

